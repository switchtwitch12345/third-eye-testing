+  }, []);
+
+  // #/replay/<game>/<second> opens that game at that moment (also how a replay can be linked to)
+  useEffect(() => {
+    const [, id, sec] = location.hash.replace(/^#\/?/, "").split("/");
+    if (id) open(id, sec ? Number(sec) : 0);
+  }, []); // eslint-disable-line react-hooks/exhaustive-deps
+
+  const open = async (id: string, at = 0) => {
+    setPlaying(false); setErr(""); setPick(null); setPlaced(null);
+    try {
+      const r = await fetch(G(`game_replay.json?run=${encodeURIComponent(id)}`), { cache: "no-store" });
+      if (!r.ok) throw new Error(`${r.status}`);
+      const data: Rep = await r.json();
+      // An older game did not record when the tower fell; the Live session did: use its end if it ended in a game over.
+      if (!data.exact && !data.events.some((e) => e.ev === "gameover")) {
+        try {
+          const all = await api<SessionMeta[]>("/api/sessions");
+          const hit = all.find((s) => s.outcome === "game_over" && s.alert_count >= 1 && (s.source ?? "").includes(":8000") && s.ended_at
+            && Date.parse(s.ended_at) >= data.start_ms && Date.parse(s.ended_at) <= data.start_ms + (data.duration_s + 120) * 1000);
+          if (hit?.ended_at) {
+            data.events.push({ t_s: Math.max(0, (Date.parse(hit.ended_at) - data.start_ms) / 1000), ev: "gameover", reason: "the tower fell" });
+            data.events.sort((a, b) => a.t_s - b.t_s);
+          }
+        } catch { /* no sessions to look at */ }
+      }
