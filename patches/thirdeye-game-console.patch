+"""The /game/... pass-through to the game server: only the listed paths, only to the configured address."""
+
+import json
+import threading
+from http.server import BaseHTTPRequestHandler, HTTPServer
+
+import pytest
+
+from thirdeye.server import gameproxy
+
+
+class _Fake(BaseHTTPRequestHandler):
+    seen: list = []
+
+    def do_GET(self):
+        body = json.dumps({"tower": {"layers": 9, "removed": []}}).encode()
+        self.send_response(200); self.send_header("Content-Type", "application/json")
+        self.end_headers(); self.wfile.write(body)
+
+    def do_POST(self):
+        n = int(self.headers.get("Content-Length", 0))
+        _Fake.seen.append((self.path, self.rfile.read(n)))
+        self.send_response(200); self.end_headers(); self.wfile.write(b"OK")
+
+    def log_message(self, *a):  # quiet
+        pass
+
+
+@pytest.fixture()
+def fake(monkeypatch):
+    srv = HTTPServer(("127.0.0.1", 0), _Fake)
+    threading.Thread(target=srv.serve_forever, daemon=True).start()
+    monkeypatch.setattr(gameproxy, "GAME_URL", f"http://127.0.0.1:{srv.server_port}")
+    _Fake.seen.clear()
+    yield srv
+    srv.shutdown()
+
+
+def test_status_and_command_pass_through(fake):
+    code, body, ctype = gameproxy.forward("GET", "status.json")
+    assert code == 200 and json.loads(body)["tower"]["layers"] == 9 and "json" in ctype
+    code, body, _ = gameproxy.forward("POST", "cmd/tower", b'{"layers": 12, "removed": []}')
+    assert code == 200 and _Fake.seen == [("/cmd/tower", b'{"layers": 12, "removed": []}')]
+
+
+@pytest.mark.parametrize("method,path", [("GET", "../../etc/passwd"), ("GET", "upload"), ("POST", "cmd/anything"),
+                                         ("POST", "status.json"), ("GET", "cmd/start")])
+def test_other_paths_are_refused(fake, method, path):
+    with pytest.raises(KeyError):
+        gameproxy.forward(method, path)
+
+
+def test_unreachable_game_server_is_reported(monkeypatch):
+    monkeypatch.setattr(gameproxy, "GAME_URL", "http://127.0.0.1:9")
+    with pytest.raises(gameproxy.GameUnreachable):
+        gameproxy.forward("GET", "status.json", timeout=1.0)
+
+
+def test_routes_are_mounted_and_refuse_other_paths(fake, tmp_path):
+    from fastapi.testclient import TestClient
+    from thirdeye.server.app import create_app
+    from thirdeye.server.auth import Auth
+    from thirdeye.server.store import LocalStore
+    app = create_app(log_dir=tmp_path, store=LocalStore(tmp_path / "store"), auth=Auth())
+    with TestClient(app) as c:
+        assert c.get("/game/status.json").json()["tower"]["layers"] == 9
+        assert c.get("/game/secrets").status_code == 404
+        assert c.post("/game/cmd/mark").status_code == 200
+        assert c.get("/game_info").json()["url"].startswith("http://127.0.0.1:")
diff --git a/tests/test_layerfinder.py b/tests/test_layerfinder.py
new file mode 100644
index 0000000..101e14d
--- /dev/null
+++ b/tests/test_layerfinder.py
@@ -0,0 +1,77 @@
+"""The colour-only crop-difference layer finder."""
+
+from __future__ import annotations
+
+import cv2
+import numpy as np
+
+from thirdeye.perception.layerfinder import find_layer, index_crops, possible
+
+TAP = 20_000
+
+
+def face(seed: int) -> np.ndarray:
+    """A block end face: wood-ish noise, the same every frame for one seed."""
+    rng = np.random.default_rng(seed)
+    return cv2.GaussianBlur(rng.integers(90, 200, (48, 48), dtype=np.uint8), (5, 5), 0)
+
+
+def write_session(root, *pulled: tuple[int, int], cams=("iphone", "android"), layers=6):
+    """Crops every 500 ms for every slot; pulled ones turn to a dark hole at TAP."""
+    for cam in cams:
+        (root / cam).mkdir(parents=True)
+        for ms in range(10_000, 26_000, 500):
+            for layer in range(layers):
+                for slot in range(3):
+                    img = face(100 * layer + slot)
+                    if (layer, slot) in pulled and ms > TAP:
+                        img = np.full_like(img, 25)
+                    noise = np.random.default_rng(ms + layer).normal(0, 3, img.shape)
+                    img = np.clip(img + noise, 0, 255).astype(np.uint8)
+                    cv2.imwrite(str(root / cam / f"{ms}_L{layer}_S{slot}_p.jpg"), img)
+            # side faces are not end faces and are ignored
+            cv2.imwrite(str(root / cam / f"{ms}_L0_S0_p_side.jpg"), face(0))
+
+
+def test_index_keeps_end_faces_only(tmp_path):
+    write_session(tmp_path, (2, 1), cams=("iphone",), layers=2)
+    idx = index_crops(tmp_path)
+    assert set(idx) == {("iphone", layer, slot) for layer in range(2) for slot in range(3)}
+    stamps = [t for t, _ in idx[("iphone", 0, 0)]]
+    assert stamps == sorted(stamps) and len(stamps) == 32
+
+
+def test_the_layer_whose_face_changed_is_found(tmp_path):
+    write_session(tmp_path, (3, 1))
+    rank = find_layer(index_crops(tmp_path), TAP, slot=1, prev_ms=11_000)
+    assert rank[0] == 3          # counted from 0, as the crop names are
+    assert sorted(rank) == list(range(6))
+
+
+def test_the_tap_slot_limits_the_search(tmp_path):
+    # Two faces change at once, in different slots: each slot's tap finds its own.
+    write_session(tmp_path, (3, 1), (1, 0))
+    idx = index_crops(tmp_path)
+    assert find_layer(idx, TAP, slot=1, prev_ms=11_000)[0] == 3
+    assert find_layer(idx, TAP, slot=0, prev_ms=11_000)[0] == 1
+
+
+def test_no_crops_around_the_tap_gives_no_answer(tmp_path):
+    write_session(tmp_path, (3, 1), cams=("iphone",), layers=2)
+    assert find_layer(index_crops(tmp_path), 90_000, slot=1) == []
+
+
+def test_physically_impossible_pulls_are_ruled_out(tmp_path):
+    # Layers 2 and 3 both change in slot 1, but slot 1 of layer 3 is already out.
+    write_session(tmp_path, (3, 1), (2, 1))
+    idx = index_crops(tmp_path)
