+// Replay a recorded game: pick one, then play or scrub through it in 3D.  Each pull appears at the moment it was made, with how
+// it was decided (the system alone, your yes, typed), and the iPhone / Android pictures from just before and after.  The
+// data comes from the game server (dataset/<run>/): games recorded since the event recorder existed are exact; older ones are
+// put together from the answers that were saved, and say so.
+
+import { Suspense, lazy, useEffect, useMemo, useRef, useState } from "react";
+import { API, api, type SessionMeta, type Tower } from "../api";
+import { Banner } from "../App";
+import type { Flash } from "../jenga";
+
+const Tower3D = lazy(() => import("../components/Tower3D"));
+const G = (p: string) => `${API}/game/${p}`;
+
+interface GameRow {
+  id: string; start_clock: string; duration_s: number; taps: number; pulls: number; exact: boolean; game_over: boolean; layers: number;
+}
+interface Ev {
+  t_s: number; ev: string; block?: [number, number]; how?: string | null; pct?: number | null; seq?: number | null;
+  layers?: number; on?: boolean; reason?: string | null; removed?: [number, number][];
+}
+interface Rep {
+  id: string; start_ms: number; start_clock: string; duration_s: number; exact: boolean; layers: number; placed: boolean;
+  initial_removed: [number, number][]; events: Ev[]; taps: { seq: number; t_s: number }[];
+}
+
+interface Now { layers: number; placed: boolean; removed: [number, number][]; over: string | null; last: Ev | null; lastIdx: number }
+
+/** The game as it stood at second T: replay the recorded events up to then. */
+function stateAt(rep: Rep, T: number, placedOverride: boolean | null): Now {
+  let layers = rep.layers, placed = placedOverride ?? rep.placed, over: string | null = null, last: Ev | null = null, lastIdx = -1;
+  let removed: [number, number][] = rep.initial_removed.map((b) => [b[0], b[1]]);
+  rep.events.forEach((e, i) => {
+    if (e.t_s > T) return;
+    if (e.ev === "pull" && e.block) {
+      removed = [...removed.filter((b) => !(b[0] === e.block![0] && b[1] === e.block![1])), [e.block[0], e.block[1]]];
+      last = e; lastIdx = i;
+    } else if (e.ev === "unpull" && e.block) {
+      removed = removed.filter((b) => !(b[0] === e.block![0] && b[1] === e.block![1]));
+    } else if (e.ev === "gameover") over = e.reason ?? "the tower fell";
+    else if (e.ev === "gameover_cleared") over = null;
+    else if (e.ev === "reset") { layers = e.layers ?? layers; removed = (e.removed ?? []).map((b) => [b[0], b[1]]); over = null; }
+    else if (e.ev === "layers") layers = e.layers ?? layers;
+    else if (e.ev === "placed" && placedOverride === null) placed = !!e.on;
+  });
+  return { layers, placed, removed, over, last, lastIdx };
+}
+
+/** The tower the 3D view draws: the start layers, minus the pulled blocks, with each pulled block put back on top if the game was played that way. */
+function towerFrom(n: Now): { tower: Tower; put: [number, number] | null } {
+  const present = new Set<string>();
+  for (let l = 0; l < n.layers; l++) for (let s = 0; s < 3; s++) present.add(`${l},${s}`);
+  let top = n.layers - 1, put: [number, number] | null = null;
+  for (const [l, s] of n.removed) {
+    present.delete(`${l},${s}`);
+    if (!n.placed) continue;
+    const free = [0, 1, 2].filter((sl) => !present.has(`${top},${sl}`));
+    if (free.length) { present.add(`${top},${free[0]}`); put = [top, free[0]]; }
+    else { top += 1; present.add(`${top},0`); put = [top, 0]; }
+  }
+  const total = n.placed ? top + 1 : n.layers;
+  const rows = Array.from({ length: total }, (_, l) => [0, 1, 2].map((s) => (present.has(`${l},${s}`) ? 1 : 0)));
+  let topLayer = 0, topComplete = 0;
+  rows.forEach((r, l) => { if (r.some(Boolean)) topLayer = l; if (r.every(Boolean)) topComplete = l; });
+  const free = [0, 1, 2].filter((s) => !rows[topLayer][s]);
+  const legal: [number, number][] = free.length ? free.map((s) => [topLayer, s]) : [0, 1, 2].map((s) => [topLayer + 1, s]);
+  return { tower: { rows, top_layer: topLayer, top_complete_layer: topComplete, legal_slots: legal }, put };
+}
+
+const mmss = (s: number) => `${Math.floor(s / 60)}:${String(Math.floor(s % 60)).padStart(2, "0")}`;
+const howText = (e: Ev) => `${e.how ?? "set by hand"}${e.pct ? ` · ${e.pct}% sure` : ""}`;
+
+export default function Replay() {
+  const [games, setGames] = useState<GameRow[] | null>(null);
+  const [err, setErr] = useState("");
+  const [rep, setRep] = useState<Rep | null>(null);
+  const [T, setT] = useState(0);
+  const [playing, setPlaying] = useState(false);
+  const [speed, setSpeed] = useState(4);
+  const [placed, setPlaced] = useState<boolean | null>(null);
+  const [pick, setPick] = useState<number | null>(null);          // the move whose pictures are shown
+  const timer = useRef(0);
+
+  useEffect(() => {
