+                <Tower3D tower={view.tower} mode="legal" flash={flash} />
+              </Suspense>
+              {now.over && <div className="rp-over">THE TOWER FELL<br /><small>{now.over}</small></div>}
+              <div className="rp-clock">{mmss(T)} / {mmss(rep.duration_s)} · {now.removed.length} pulled</div>
+            </div>
+            <div className="rp-controls">
+              <button className="g-btn" onClick={() => step(-1)}>⏮ previous pull</button>
+              <button className="g-btn g-primary" onClick={() => { if (T >= rep.duration_s - 0.2) setT(0); setPlaying(!playing); }}>
+                {playing ? "⏸ pause" : "▶ play"}
+              </button>
+              <button className="g-btn" onClick={() => step(1)}>next pull ⏭</button>
+              <select value={speed} onChange={(e) => setSpeed(Number(e.target.value))}>
+                {[1, 2, 4, 8, 16].map((s) => <option key={s} value={s}>{s}×</option>)}
+              </select>
+            </div>
+            <div className="rp-track">
+              <input type="range" min={0} max={rep.duration_s} step={0.1} value={T} onChange={(e) => jump(Number(e.target.value))} />
+              <div className="rp-ticks">
+                {rep.taps.map((t) => <i key={`t${t.seq}`} className="rp-t" style={{ left: `${(100 * t.t_s) / rep.duration_s}%` }} title={`tap ${t.seq}`} />)}
+                {pulls.map((p) => <i key={`p${p.i}`} className="rp-p" style={{ left: `${(100 * p.e.t_s) / rep.duration_s}%` }}
+                  title={`layer ${p.e.block![0] + 1}`} onClick={() => { setPick(p.i); jump(p.e.t_s + 0.05); }} />)}
+                {fall && <i className="rp-f" style={{ left: `${(100 * fall.t_s) / rep.duration_s}%` }} title="the tower fell" />}
+              </div>
+              <div className="rp-legend"><i className="rp-t" /> tap on MARK <i className="rp-p" /> block pulled <i className="rp-f" /> tower fell</div>
+            </div>
+          </>
+        )}
+      </section>
+
+      <aside className="rp-side">
+        {rep && (
+          <>
+            <h3>Moves</h3>
+            {pulls.length === 0 && <p className="muted">No block was recorded as pulled in this game.</p>}
+            {pulls.map((p, n) => (
+              <button key={p.i} className={`rp-move ${shown === p.e ? "on" : ""} ${T >= p.e.t_s ? "" : "later"}`}
+                onClick={() => { setPick(p.i); jump(p.e.t_s + 0.05); }}>
+                <b>{n + 1}</b> <span>{mmss(p.e.t_s)}</span> layer {p.e.block![0] + 1}, slot {p.e.block![1]}
+                <small>{howText(p.e)}</small>
+              </button>
+            ))}
+            {fall && <div className="rp-move fall"><b>✕</b> <span>{mmss(fall.t_s)}</span> the tower fell</div>}
+            {shown && shown.block && (
+              <>
+                <h3>Move at {mmss(shown.t_s)}: layer {shown.block[0] + 1}</h3>
+                <div className="rp-pics">
+                  {(["iphone", "android"] as const).flatMap((cam) => [[-3, "before"], [3, "after"]].map(([d, w]) => (
+                    <figure key={`${cam}${w}`}>
+                      <img src={pic(cam, tapT(shown) + (d as number))} alt={`${cam} ${w}`}
+                        onError={(ev) => ((ev.currentTarget.style.visibility = "hidden"))} />
+                      <figcaption>{cam} · {w as string}</figcaption>
+                    </figure>
+                  )))}
+                </div>
+                <p className="muted small">Pictures are the saved frames nearest those moments; some old games' pictures have been cleared.</p>
+              </>
+            )}
+          </>
+        )}
+      </aside>
+    </div>
+  );
+}
