+        if (nt >= rep.duration_s) { setPlaying(false); return rep.duration_s; }
+        return nt;
+      });
+    }, 100);
+    return () => clearInterval(timer.current);
+  }, [playing, speed, rep]);
+
+  const now = useMemo(() => (rep ? stateAt(rep, T, placed) : null), [rep, T, placed]);
+  const view = useMemo(() => (now ? towerFrom(now) : null), [now]);
+  const flash = useMemo<Flash | undefined>(() => {
+    if (!now?.last || !now.last.block || T - now.last.t_s > 2.5) return undefined;
+    return { from: now.last.block, to: view?.put ?? undefined, key: now.lastIdx + 1 };
+  }, [now, view, T]);
+
+  const pulls = rep ? rep.events.map((e, i) => ({ e, i })).filter((x) => x.e.ev === "pull") : [];
+  const fall = rep?.events.find((e) => e.ev === "gameover");
+  const jump = (t: number) => { setPlaying(false); setT(Math.max(0, Math.min(rep?.duration_s ?? 0, t))); };
+  const step = (dir: number) => {
+    if (!pulls.length) return;
+    const times = pulls.map((p) => p.e.t_s);
+    const target = dir > 0 ? times.find((t) => t > T + 0.05) : [...times].reverse().find((t) => t < T - 0.05);
+    if (target !== undefined) jump(target + 0.05);
+  };
+  const shown = pick !== null ? rep?.events[pick] : now?.last ?? undefined;
+  const tapT = (e?: Ev) => (e && rep ? rep.taps.find((t) => t.seq === e.seq)?.t_s ?? e.t_s - 3 : 0);
+  const pic = (cam: string, t: number) => G(`game_frame.jpg?run=${rep!.id}&cam=${cam}&t=${Math.max(0, t).toFixed(1)}`);
+
+  return (
+    <div className="rp">
+      <aside className="rp-list">
+        <h3>Recorded games</h3>
+        {err && <Banner kind="warn">{err}</Banner>}
+        {games === null && !err && <p className="muted">Loading…</p>}
+        {games?.length === 0 && <p className="muted">No recorded games yet. Turn on data capture and play one.</p>}
+        {games?.map((g) => (
+          <button key={g.id} className={`rp-game ${rep?.id === g.id ? "on" : ""}`} onClick={() => open(g.id)}>
+            <b>{g.start_clock.slice(5, 16)}</b>
+            <span>{mmss(g.duration_s)} · {g.pulls} pulls · {g.layers} layers</span>
+            <span className="muted">{g.exact ? "exact record" : "rebuilt from answers"}{g.game_over ? " · fell" : ""}</span>
+          </button>
+        ))}
+      </aside>
+
+      <section className="rp-main">
+        {!rep || !now || !view ? <p className="muted">Pick a game on the left.</p> : (
+          <>
+            <div className="rp-head">
+              <b>{rep.start_clock}</b> · {mmss(rep.duration_s)} · {pulls.length} pulls
+              {!rep.exact && <span className="rp-note">rebuilt from the saved answers: the exact slot of a typed move is a best guess</span>}
+              <label className="rp-put">
+                <input type="checkbox" checked={now.placed} onChange={(e) => setPlaced(e.target.checked)} /> pulled blocks go back on top
+              </label>
+            </div>
+            <div className="rp-stage">
