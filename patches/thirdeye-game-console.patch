+.rp { display: grid; grid-template-columns: 240px minmax(0, 1fr) 320px; gap: var(--s4); align-items: start; }
+@media (max-width: 1150px) { .rp { grid-template-columns: 1fr; } }
+.rp h3 { margin: 0 0 var(--s2); font: 600 12px/16px var(--font); letter-spacing: .4px; text-transform: uppercase; color: var(--muted); }
+.rp-list, .rp-side { display: flex; flex-direction: column; gap: 6px; }
+.rp-game, .rp-move { text-align: left; background: var(--panel); border: 1px solid var(--line); color: inherit; border-radius: var(--r-m); padding: 9px 12px; display: flex; flex-direction: column; gap: 2px; cursor: pointer; font: var(--t-callout); flex: none; min-height: 0; }
+.rp-game:hover, .rp-move:hover { background: var(--fill); }
+.rp-game.on, .rp-move.on { background: var(--accent-bg); border-color: var(--accent); }
+.rp-game b { font: 600 14px/18px var(--font); }
+.rp-move { flex-direction: row; flex-wrap: wrap; align-items: baseline; gap: 6px; }
+.rp-move small { flex-basis: 100%; color: var(--muted); }
+.rp-move.later { opacity: .5; }
+.rp-move.fall { border-color: var(--bad); background: var(--bad-bg); cursor: default; }
+.rp-head { display: flex; flex-wrap: wrap; gap: 10px; align-items: baseline; margin-bottom: var(--s2); }
+.rp-note { color: var(--warn); font: var(--t-sub); }
+.rp-put { margin-left: auto; font: var(--t-callout); color: var(--ink); cursor: pointer; display: flex; align-items: center; gap: 8px; margin-top: 0; }
+.rp-stage { position: relative; }
+.rp-stage .tower3d { height: min(58vh, 620px); }
+.rp-over { position: absolute; inset: 0; display: grid; place-content: center; text-align: center; font: 700 32px/40px var(--font); color: #fff; background: rgba(196, 22, 42, .62); border-radius: var(--r-l); pointer-events: none; }
+.rp-clock { position: absolute; left: 12px; bottom: 12px; background: color-mix(in srgb, var(--panel) 80%, transparent); -webkit-backdrop-filter: blur(12px); backdrop-filter: blur(12px); padding: 3px 10px; border-radius: 999px; font: 600 12px/18px var(--font); font-variant-numeric: tabular-nums; }
+.rp-controls { display: flex; flex-wrap: wrap; gap: var(--s2); align-items: center; margin: var(--s3) 0 var(--s1); }
+.rp-controls button, .rp-controls select { width: auto; flex: none; }
+.rp-track { position: relative; }
+.rp-track input[type=range] { width: 100%; }
+.rp-ticks { position: relative; height: 16px; }
+.rp-ticks i, .rp-legend i { position: absolute; top: 2px; width: 3px; height: 12px; border-radius: 2px; background: var(--faint); }
+.rp-ticks i.rp-p, .rp-legend i.rp-p { background: var(--ok); width: 6px; cursor: pointer; }
+.rp-ticks i.rp-f, .rp-legend i.rp-f { background: var(--bad); width: 6px; }
+.rp-legend { font: var(--t-sub); color: var(--muted); display: flex; gap: 6px; align-items: center; }
+.rp-legend i { position: static; display: inline-block; margin: 0 2px 0 8px; }
+.rp-pics { display: grid; grid-template-columns: 1fr 1fr; gap: 6px; }
+.rp-pics figure { margin: 0; }
+.rp-pics img { width: 100%; border-radius: var(--r-m); background: var(--panel-2); min-height: 60px; }
+.rp-pics figcaption { font: var(--t-sub); color: var(--muted); }
+
+kbd { font: 600 11px/16px var(--font); padding: 0 6px; border-radius: 5px; background: var(--fill-2); color: var(--muted); border: 1px solid var(--line); }
+.g-btn kbd { margin-left: 8px; }
+.g-card details > summary { margin-top: var(--s2); }
+
+.live details.controls { background: var(--card, var(--fill)); border-radius: var(--r-l, 14px); padding: var(--s3) var(--s4); }
+.live details.controls > summary { font: var(--t-sub); color: var(--muted); }
+.live details.controls[open] > summary { margin-bottom: var(--s3); }
+.live .stage { min-height: 520px; }
+.live > *, .g-wrap > *, .rp > * { min-width: 0; } main { overflow-x: clip; }
+.status .pill { align-self: center; flex: none; padding: 6px 12px; }
+
+.live .side { gap: var(--s3); }
+.live .side .gp { display: flex; flex-direction: column; gap: var(--s3); }
+.live .side .g-card { background: var(--fill); border: 0; }
+.side-seg { display: flex; width: 100%; }
+.side-seg button { flex: 1; }
+.live .side .g-alert { border-radius: var(--r-m); padding: 10px 12px; font: var(--t-callout); }
